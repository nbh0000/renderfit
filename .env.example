# ─────────────────────────────────────────────────────────────
# 값이 없으면 자동으로 Mock provider + 로컬 저장소로 동작한다.
# (API key 없이도 모든 기능이 끝까지 실행된다 — Demo Mode)
# ─────────────────────────────────────────────────────────────

# ── Provider 선택 (미지정 시 자동) ──
AI_PROVIDER=
LLM_PROVIDER=
VISION_PROVIDER=
GENERATION_PROVIDER=
STORAGE_PROVIDER=

# ── 이미지 생성 (Gemini 이미지 편집 API / Nano Banana 계열) ──
GEMINI_API_KEY=
# 사용할 이미지 모델 (기본: gemini-2.5-flash-image)
GEMINI_IMAGE_MODEL=

# ── LLM (AI Command 라우팅). 없으면 규칙 기반 라우터로 동작 ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=

# ── Supabase (인증 · PostgreSQL · Storage) ──
# 비어 있으면 로그인 없이 로컬 파일(.data)에 저장한다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ── 오브젝트 스토리지 (S3 호환) ──
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# ── 백그라운드 큐 (미설정 시 in-process 큐) ──
REDIS_URL=

# ── 토스페이먼츠 (결제 UI만 구현, 실연동 TODO) ──
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ── 배포 ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
