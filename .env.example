# ─────────────────────────────────────────────────────────────
# 값이 없으면 자동으로 Mock provider + 로컬 저장소로 동작한다.
# (API key 없이도 모든 기능이 끝까지 실행된다 — Demo Mode)
# ─────────────────────────────────────────────────────────────

# ── Provider 선택 (미지정 시 자동) ──
AI_PROVIDER=
LLM_PROVIDER=
VISION_PROVIDER=
GENERATION_PROVIDER=
STORAGE_PROVIDER=

# ── 이미지 생성 (Gemini 이미지 편집 API / Nano Banana 계열) ──
GEMINI_API_KEY=
# 사용할 이미지 모델 (기본: gemini-2.5-flash-image)
GEMINI_IMAGE_MODEL=

# ── LLM (AI Command 라우팅). 없으면 규칙 기반 라우터로 동작 ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=

# ── Supabase (인증 · PostgreSQL · Storage) ──
# 비어 있으면 로그인 없이 로컬 파일(.data)에 저장한다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ── 오브젝트 스토리지 (S3 호환) ──
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# ── 백그라운드 큐 (미설정 시 in-process 큐) ──
REDIS_URL=

# ── 토스페이먼츠 (결제 UI만 구현, 실연동 TODO) ──
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ── 배포 ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 무료 3D 모델 (Poly Pizza) ──
# https://poly.pizza/api 에서 무료로 발급. 없으면 에셋 탭의 무료 모델 검색만 꺼진다.
POLY_PIZZA_API_KEY=

# ── 도면 파싱 서비스 ──
# services/plan-ingest 를 띄운 주소. 없으면 http://127.0.0.1:8001 로 본다.
# 배포에서는 반드시 넣는다 — 없으면 컨테이너 안의 127.0.0.1 을 찾아가 도면 기능이 통째로 죽는다.
PLAN_INGEST_URL=

# ── 관리자 ──
# 쉼표로 구분. 비어 있으면 아무도 /admin 에 못 들어간다.
ADMIN_EMAILS=

# ── 운영자 알림 (문의 접수·결제 사고) ──
# 카카오톡 "나에게 보내기": developers.kakao.com 에서 앱을 만들고 talk_message 권한으로
# 토큰을 받는다. refresh token 을 같이 넣으면 만료 시 스스로 갱신한다.
KAKAO_REST_API_KEY=
KAKAO_ACCESS_TOKEN=
KAKAO_REFRESH_TOKEN=
# 대신(또는 함께) 쓸 수 있는 경로 — 텔레그램 봇, 슬랙·디스코드 웹훅
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

# ── 정산 ──
# API 비용을 원화로 환산할 때 쓰는 환율. 비우면 1400.
USD_KRW=
